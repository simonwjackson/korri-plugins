From: Korri plugin packaging
Subject: [PATCH] Stop the Linux main loop before destroying audio synchronization

libultraship's SIGINT/SIGTERM ShutdownHandler still calls exit(1) in 5.0.1.
With the 2 Ship audio worker waiting, static destruction can deadlock in
pthread_cond_destroy. Install flag-only handlers before the early startup
window is created, then restore them after InitCrashHandler without clearing
pending requests. Request a normal main-loop exit; DeinitOTR joins the worker.
No logging, allocation, SDL calls or teardown run in the signal handler.

5.0.1 already has an int native entry point, but add an explicit zero return
so successful cleanup has a defined exit status on both architectures.

--- a/mm/src/code/main.c
+++ b/mm/src/code/main.c
@@ -151,4 +151,5 @@
     FreeConsole();
 #endif
     Heaps_Free();
+    return 0;
 }
--- a/mm/src/code/graph.c
+++ b/mm/src/code/graph.c
@@ -7,6 +7,7 @@
 #include <libultraship/bridge/consolevariablebridge.h>
 #include <libultraship/bridge/windowbridge.h>
 #include <string.h>
+#include <signal.h>
 
 // Variables are put before most headers as a hacky way to bypass bss reordering
 FaultAddrConvClient sGraphFaultAddrConvClient;
@@ -426,8 +427,24 @@
     Graph_Destroy(&runFrameContext.gfxCtx);
 }
 
+static volatile sig_atomic_t sShutdownRequested = 0;
+
+static void Graph_RequestShutdown(int signalNumber) {
+    sShutdownRequested = 1;
+}
+
+void Graph_InstallShutdownHandlers(void) {
+    struct sigaction shutdownAction = { 0 };
+    shutdownAction.sa_handler = Graph_RequestShutdown;
+    sigemptyset(&shutdownAction.sa_mask);
+    sigaction(SIGINT, &shutdownAction, NULL);
+    sigaction(SIGTERM, &shutdownAction, NULL);
+}
+
 void Graph_ThreadEntry(void* arg0) {
-    while (WindowIsRunning()) {
+    // The caller owns teardown, including joining the audio worker. Do not
+    // call exit from a signal handler while its condition variable is in use.
+    while (!sShutdownRequested && WindowIsRunning()) {
         RunFrame();
     }
 }
--- a/mm/2s2h/BenPort.cpp
+++ b/mm/2s2h/BenPort.cpp
@@ -120,6 +120,7 @@
 GameInteractor* GameInteractor::Instance;
 AudioCollection* AudioCollection::Instance;
 
+extern "C" void Graph_InstallShutdownHandlers(void);
 extern "C" char** cameraStrings;
 bool prevAltAssets = false;
 std::vector<std::shared_ptr<std::string>> cameraStdStrings;
@@ -174,4 +175,7 @@
     auto benInputEditorWindow = std::make_shared<BenInputEditorWindow>("gWindows.BenInputEditor", "2S2H Input Editor");
     benFast3dWindow =
         std::make_shared<Fast::Fast3dWindow>(std::vector<std::shared_ptr<Ship::GuiWindow>>({ benInputEditorWindow }));
+    // The extraction/startup window is visible before Initialize installs the
+    // crash handler. Record early shutdown requests before creating that window.
+    Graph_InstallShutdownHandlers();
     context->InitWindow(benFast3dWindow);
@@ -636,6 +640,9 @@
     context->GetResourceManager()->SetAltAssetsEnabled(prevAltAssets);
 
     context->InitCrashHandler();
+    // Restore flag-only handlers after the crash handler overrides them.
+    // Do not clear any shutdown request received during early window creation.
+    Graph_InstallShutdownHandlers();
 
     context->GetWindow()->SetAutoCaptureMouse(CVarGetInteger("gSettings.EnableMouse", 0) &&
                                               CVarGetInteger("gSettings.AutoCaptureMouse", 1));
