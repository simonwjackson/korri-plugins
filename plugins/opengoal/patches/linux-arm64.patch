diff --git a/CMakeLists.txt b/CMakeLists.txt
index 57415f2d..b4ec8cf3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -48,6 +48,16 @@ if (APPLE)
     set(CMAKE_OSX_SYSROOT "${MACOSX_SYSROOT}" CACHE PATH "macOS SDK path" FORCE)
 endif()
 
+# Linux ARM builds must not inherit x86 AVX or build-host CPU extensions.
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$" AND NOT APPLE)
+    # CRC32 is available on Cortex-A55/A77; no Apple or host-specific ISA flags.
+    # Kernel format_struct uses plain char with a negative "unset" sentinel.
+    # Linux ARM defaults to unsigned char, unlike the existing runtime builds.
+    set(OG_ARCH_FLAGS "-march=armv8-a+crc -fsigned-char")
+else()
+    set(OG_ARCH_FLAGS "-mavx")
+endif()
+
 # Setup compiler flags
 if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
     message(STATUS "Clang Detected - Setting Defaults")
@@ -56,7 +66,7 @@ if(CMAKE_CXX_COMPILER_ID STREQUAL "Clang")
         -fcxx-exceptions \
         -fexceptions \
         -fdiagnostics-color=always \
-        -mavx \
+        ${OG_ARCH_FLAGS} \
         -Wall \
         -Wno-c++11-narrowing \
         -Wno-c++98-compat \
@@ -111,7 +121,7 @@ elseif(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
         -Wshadow \
         -Wsign-promo \
         -fdiagnostics-color=always \
-        -mavx")
+        ${OG_ARCH_FLAGS}")
 
     # additional c++ flags for release mode for our projects
     if(CMAKE_BUILD_TYPE MATCHES "Release")
