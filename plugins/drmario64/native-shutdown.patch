 extern "C" void yield_self_1ms(RDRAM_ARG1) {
+    // Dr. Mario 64 injects this hook only in its lowest-priority IDLE loop.
+    // Scheduling is cooperative: park here without dispatching another worker.
+    // Never return/throw, since the thread epilogue would resume a successor.
+    if (exited.load()) {
+        game_shutdown_acknowledged.store(true);
+        game_shutdown_acknowledged.notify_one();
+        for (;;) {
+            game_shutdown_acknowledged.wait(true);
+        }
+    }
     ultramodern::wait_for_external_message_timed(PASS_RDRAM1, 1);
     ultramodern::check_running_queue(PASS_RDRAM1);
 }
